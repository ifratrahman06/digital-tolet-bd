# ========================================================
# Digital To-Let BD — Environment Configuration Template
# ========================================================

# MongoDB Atlas Connection URI (Primary Database)
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database_name>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/digital_tolet_db?retryWrites=true&w=majority

# Cloudinary Credentials (Server-side image upload & optimization)
# Obtain free from: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Next.js Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3001
